# syntax=docker/dockerfile:1.7

# Flutter is build-only. Keeping its inputs narrow lets backend and Compose
# changes reuse the existing web bundle layer.
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS flutter-toolchain
ARG FLUTTER_VERSION=3.47.2
ARG FLUTTER_SHA256=447878859d01ca9bfdb99a85f245af07ed8a15fedcd9d189c4749e8e92d1f185
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates curl git libglu1-mesa unzip xz-utils \
  && rm -rf /var/lib/apt/lists/* \
  && curl --fail --location --silent --show-error \
    --output /tmp/flutter.tar.xz \
    "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" \
  && echo "${FLUTTER_SHA256}  /tmp/flutter.tar.xz" | sha256sum --check --strict \
  && tar --extract --xz --file /tmp/flutter.tar.xz --directory /opt \
  && rm /tmp/flutter.tar.xz \
  && chown -R root:root /opt/flutter
ENV PATH="/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:${PATH}"
RUN flutter config --no-analytics \
  && flutter precache --web

FROM flutter-toolchain AS web-build
WORKDIR /workspace
COPY pubspec.yaml pubspec.lock ./
COPY app/pubspec.yaml app/pubspec.yaml
COPY admin/pubspec.yaml admin/pubspec.yaml
COPY backend/hayer_client/pubspec.yaml backend/hayer_client/pubspec.yaml
COPY backend/hayer_server/pubspec.yaml backend/hayer_server/pubspec.yaml
RUN flutter pub get --enforce-lockfile
COPY app app
COPY admin admin
COPY backend/hayer_client backend/hayer_client
RUN cd app \
  && flutter build web --release --wasm --no-pub --base-href /app/ \
  && cd ../admin \
  && flutter build web --release --wasm --no-pub --base-href /

# Dart is also build-only. Production runs standalone native executables and
# does not contain the SDK, package cache, source tree, or development watcher.
FROM dart:3.13.2@sha256:1f86408456fbcdc5f9c33fa267d3680d86e79c255ec338b9a215459224769770 AS native-build
WORKDIR /workspace
# The root workspace includes the Flutter app and admin packages. Keep the Dart
# image's /runtime payload for the final native bundles, but resolve the shared
# lockfile with the Flutter SDK from the build-only toolchain stage.
COPY --from=flutter-toolchain /opt/flutter /opt/flutter
ENV PATH="/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:${PATH}"
COPY pubspec.yaml pubspec.lock ./
COPY app/pubspec.yaml app/pubspec.yaml
COPY admin/pubspec.yaml admin/pubspec.yaml
COPY backend/hayer_client/pubspec.yaml backend/hayer_client/pubspec.yaml
COPY backend/hayer_server/pubspec.yaml backend/hayer_server/pubspec.yaml
RUN flutter pub get --enforce-lockfile
COPY backend/hayer_client backend/hayer_client
COPY backend/hayer_server backend/hayer_server
RUN cd backend/hayer_server \
  && dart build cli --target bin/main.dart --output /out/server \
  && mv /out/server/bundle/bin/main /out/server/bundle/bin/hayer-server \
  && dart build cli --target bin/runtime_init.dart --output /out/runtime-init \
  && mv /out/runtime-init/bundle/bin/runtime_init /out/runtime-init/bundle/bin/hayer-runtime-init \
  && dart build cli --target bin/place_canary.dart --output /out/place-canary \
  && mv /out/place-canary/bundle/bin/place_canary /out/place-canary/bundle/bin/hayer-place-canary \
  && cd ../hayer_client \
  && dart build cli --target bin/public_gateway_canary.dart --output /out/public-gateway-canary \
  && mv /out/public-gateway-canary/bundle/bin/public_gateway_canary /out/public-gateway-canary/bundle/bin/hayer-public-gateway-canary

FROM alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8 AS runtime
ENV runmode=production serverid=default logging=normal role=monolith
RUN apk add --no-cache apache2-utils ca-certificates curl
WORKDIR /opt/hayer
COPY --from=native-build /runtime/ /
COPY --from=native-build --chmod=755 /out/server/bundle/ bundles/server/
COPY --from=native-build --chmod=755 /out/runtime-init/bundle/ bundles/runtime-init/
COPY --from=native-build --chmod=755 /out/place-canary/bundle/ bundles/place-canary/
COPY --from=native-build --chmod=755 /out/public-gateway-canary/bundle/ bundles/public-gateway-canary/
COPY backend/hayer_server/config config
COPY backend/hayer_server/migrations migrations
COPY backend/hayer_server/web/pages web/pages
COPY backend/hayer_server/web/static web/static
COPY backend/hayer_server/web/templates web/templates
COPY --from=web-build /workspace/app/build/web web/app
COPY --from=web-build /workspace/admin/build/web web/admin
RUN mkdir -p web/static/.well-known web/static/downloads
EXPOSE 8080 8081 8082
CMD ["/opt/hayer/bundles/server/bin/hayer-server", "--mode=production", "--server-id=default", "--logging=normal", "--role=monolith", "--apply-migrations"]
