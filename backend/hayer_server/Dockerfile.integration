FROM dart:3.13.2@sha256:1f86408456fbcdc5f9c33fa267d3680d86e79c255ec338b9a215459224769770

WORKDIR /workspace

COPY backend/hayer_client/pubspec.yaml backend/hayer_client/pubspec.yaml
COPY backend/hayer_server/pubspec.yaml backend/hayer_server/pubspec.yaml
RUN printf '%s\n' \
  'name: hayer_integration_workspace' \
  'publish_to: none' \
  'environment:' \
  '  sdk: ^3.13.0' \
  'workspace:' \
  '  - backend/hayer_client' \
  '  - backend/hayer_server' \
  > pubspec.yaml \
  && dart pub get

COPY backend/hayer_client backend/hayer_client
COPY backend/hayer_server backend/hayer_server

WORKDIR /workspace/backend/hayer_server

# The session integration suite uses RollbackDatabase.disabled and shares this
# PostGIS database with the other integration suites.
CMD ["dart", "test", "integration_test", "--concurrency=1"]
