FROM dart:3.12.2

WORKDIR /workspace

COPY backend/hayer_client/pubspec.yaml backend/hayer_client/pubspec.yaml
COPY backend/hayer_server/pubspec.yaml backend/hayer_server/pubspec.yaml
RUN printf '%s\n' \
  'name: hayer_integration_workspace' \
  'publish_to: none' \
  'environment:' \
  '  sdk: ^3.12.0' \
  'workspace:' \
  '  - backend/hayer_client' \
  '  - backend/hayer_server' \
  > pubspec.yaml \
  && dart pub get

COPY backend/hayer_client backend/hayer_client
COPY backend/hayer_server backend/hayer_server

WORKDIR /workspace/backend/hayer_server

CMD ["dart", "test", "integration_test"]
